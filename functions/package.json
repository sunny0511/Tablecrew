{
  "name": "tablecrew-functions",
  "version": "0.1.0",
  "private": true,
  "description": "TableCrew Cloud Functions backend (Gen 2, TypeScript). See docs/ARCHITECTURE.md and docs/ENGINEERING_GUIDELINES.md.",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "npm run build:test && node --test $(find lib-test/test -name '*.test.js' -not -path '*/integration/*')",
    "test:coverage": "npm run build:test && node --test --experimental-test-coverage $(find lib-test/test -name '*.test.js' -not -path '*/integration/*')",
    "test:integration": "npm run build:test && node --test $(find lib-test/test/integration -name '*.test.js')",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google-cloud/vision": "4.3.2",
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@types/node": "20.16.5",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "eslint-config-google": "0.14.0",
    "typescript": "5.6.3"
  }
}
