rules_version = '2';

// Scaffold note (Milestone F0): this is a deliberate default-deny stub, not
// the real ruleset. The actual per-collection rules (Users public/private
// split, Tables, Crews, RSVPs, and the rest of docs/DATABASE.md §6's
// collections) are implemented in Milestone F1 ("Core data layer &
// security rules"), each with rules-emulator tests achieving 100% branch
// coverage per docs/TESTING.md — not before, since untested rules are
// treated the same as untested payment-processing code, per that document.
//
// Default-deny-everything is intentional and safe as a placeholder: it
// fails closed (nothing is readable/writable) rather than failing open,
// so accidentally deploying this stub to a real environment blocks all
// access rather than silently exposing data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
