rules_version = '2';

// firestore.rules — Milestone F1 (Core data layer & security rules)
//
// Scope note: only the five collections named in Milestone F1's deliverables
// (docs/IMPLEMENTATION_PLAN.md) have real rules below — users (public +
// private/profile), tables (+ rsvps subcollection), crews, and
// idempotencyKeys. Every other collection in docs/DATABASE.md (ratings,
// reports, venues, splitRequests, and the duressSignals/locationShares/
// crew-messages subcollections) is intentionally still covered only by the
// trailing default-deny catch-all at the bottom of this file — those get
// their own rules and tests in the milestone that builds the feature that
// actually needs them (F6/F7 per docs/IMPLEMENTATION_PLAN.md), per
// docs/TESTING.md's requirement that rules and their tests ship together,
// collection by collection, rather than speculatively ahead of the feature.
//
// Structural principles this file follows (docs/DATABASE.md §6, docs/SECURITY.md):
//   1. Default-deny, then the minimum explicit allow each collection needs.
//   2. Anything with a cross-document invariant (Table capacity counts, Crew
//      membership, trust/report signals) is client-write-denied and
//      Functions-only (written via the Admin SDK, which bypasses these rules,
//      inside a transaction where the invariant actually lives) — a rule
//      cannot safely read-and-conditionally-write a *different* document
//      atomically with the one being evaluated.
//   3. `users` is split into a broadly-readable public document and an
//      owner-only private document because Firestore rules are
//      document-granular, not field-granular — a rule can allow or deny
//      reading an entire document but cannot redact individual fields, so a
//      single flat user document could not satisfy both "anyone can see a
//      display name" and "no one but the owner can see a phone hash".
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function existsRsvpFor(tableId, uid) {
      return exists(/databases/$(database)/documents/tables/$(tableId)/rsvps/$(uid));
    }

    function isTableHost(tableId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/tables/$(tableId)).data.hostId == request.auth.uid;
    }

    // --- users/{userId} (public profile) + private/profile (sensitive) ---
    // docs/DATABASE.md §3.1

    match /users/{userId} {
      // Public profile: broadly readable by any authenticated user — Discover,
      // Table rosters, and Crew screens all need to render other people's
      // basic profile info. Safe by construction: this document never holds
      // anything docs/SECURITY.md restricts (no phone hash, no trust/report
      // counters, no block list, no email, no verification detail beyond the
      // public tier badge — see the private/profile split below).
      allow read: if isSignedIn();
      allow create: if false;
      // Corrected in Milestone F2 (was `isSignedIn() && request.auth.uid ==
      // userId` in F1): that rule only checked *whose* uid was being
      // created, not *what values* the create() set — a modified client
      // could have created its own profile with, e.g.,
      // `verificationTierPublic: "id_verified"` before ever completing
      // Tier 2. Now that a real account-creation callable exists
      // (`completeAccountSetup`, Milestone F2, functions/src/users/), it is
      // the only path by which this document is ever created — matching
      // how `crews` already works below. See docs/DATABASE.md §6 for the
      // full rationale.
      allow update: if isSignedIn() && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['ratingAggregate', 'verificationTierPublic', 'deletedAt']);
      // A user may edit their own public display fields directly, but never
      // their own rating aggregate, verification-tier trust badge, or
      // deletion tombstone — those move only via triggers/callables using
      // the Admin SDK, so a modified client can't self-elevate its own badge.
      allow delete: if false; // deletion is the deleteAccount callable, never a direct client delete (docs/DATABASE.md §7)

      match /private/profile {
        // Private document: readable/writable only by the owner. This is the
        // actual fix for the field-level-redaction problem noted above —
        // anything docs/SECURITY.md says must never be visible to another
        // user (phoneNumberHash, trustSignals, blockedUserIds, email, full
        // verification detail) lives here, not on the public document.
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if false;
        // Corrected in Milestone F2, same reasoning as the public document
        // above — exclusively created by `completeAccountSetup`, which is
        // what makes the dateOfBirth-gates-account-creation invariant
        // (below) actually enforceable: a rule cannot express "reject this
        // create() if computed age is under 18," but a callable can.
        allow update: if isSignedIn() && request.auth.uid == userId
                      && !request.resource.data.diff(resource.data)
                           .affectedKeys().hasAny(['trustSignals', 'verification', 'dateOfBirth', 'blockedUserIds', 'crewMemberships', 'subscription']);
        // The owner may edit notificationPrefs/fcmTokens directly, but never
        // their own trust signals, verification record, self-reported date
        // of birth (Milestone F2 — gates a safety/legal requirement, so
        // must not be editable by the account it belongs to once set, same
        // reasoning as `verification`), block list, Crew-membership
        // reverse-index, or subscription state — all Functions-only.
        // `subscription` in particular may only move in response to a
        // verified Stripe webhook, never a client write.
        allow delete: if false;
      }

      match /photoModeration/{uploadId} {
        // Milestone F5 task #97 (docs/DATABASE.md §3.1a — path corrected
        // in the same task; see that section's correction note). The owner
        // may READ their own upload's moderation verdict — Screen 5
        // (Profile Setup) listens here to know when to enable "Continue" —
        // but every write comes from the Storage-triggered moderation
        // Function (functions/src/media/) or completeAccountSetup's
        // server-side lookup, both via the Admin SDK, which bypasses these
        // rules entirely. There is no client write path to this document
        // at all: a client that could write its own verdict could
        // self-approve a photo the SafeSearch check flagged, defeating the
        // moderation gate outright.
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // --- tables/{tableId} (+ rsvps subcollection) --- docs/DATABASE.md §3.2/§3.3

    match /tables/{tableId} {
      allow read: if resource.data.visibility == 'open'
                  || (isSignedIn() && existsRsvpFor(tableId, request.auth.uid))
                  || (isSignedIn() && resource.data.hostId == request.auth.uid);
      // Open Tables are publicly discoverable; Closed Tables are readable
      // only by the host or a user with an RSVP document on this Table.
      allow create: if false;
      allow update: if false;
      // Milestone F4 correction: F1 originally allowed a signed-in host to
      // create() and update() a Table directly (blocking only `capacity`/
      // `reportFlags` from update), the same category of gap Milestone F2
      // found and fixed for `users`/`private/profile` — a rule checking
      // *whose* uid is writing says nothing about *what* gets written.
      // Concretely, the F1 rule let a client: create a Table bypassing
      // `createTable`'s idempotency-key check (API_SPEC.md §2) and its
      // host-field snapshotting/rate limiting; and, worse, write `status`
      // directly (`"cancelled"`, `"happened"`, ...) bypassing
      // `cancelTable`'s notification fan-out + Typesense removal and
      // `endTableEarly`'s `TABLE_NOT_LIVE` precondition entirely, since
      // `status` was never in the old denylist.
      //
      // Unlike `crews` below, which keeps a narrow direct-client-edit
      // allowance for genuinely invariant-free cosmetic fields (name,
      // photo), Tables goes fully Functions-only: every field
      // `updateTable`'s documented patch surface covers (API_SPEC.md
      // §3.1 — title, description, interestTag, location, startTime,
      // capacity, visibility) is subject to `updateTable`'s
      // `CANNOT_EDIT_AFTER_CONFIRMED` business rule (capacity/startTime
      // cannot shrink/move once `status` is `confirmed` or later), which
      // depends on comparing against `status` and `capacity.confirmedCount`
      // conditionally — exactly the kind of single-document-but-still-
      // conditional invariant this file's principle #2 (see header
      // comment) says belongs in a callable, not partially re-derived in
      // rules for some fields but not others. A narrower allowlist here
      // (permitting only the invariant-free-looking fields like `title`)
      // was considered and rejected: it's the kind of partial rules
      // surface a future field addition could easily miscalibrate,
      // whereas one Functions-only rule for the whole document has no
      // such failure mode. All Table creation and mutation now goes
      // through `createTable`/`updateTable`/`requestSeat`/
      // `confirmAttendee`/`cancelTable`/`cancelRsvp`/`endTableEarly`
      // (Milestone F4, `functions/src/tables/`), using the Admin SDK,
      // which bypasses this rule entirely — matching how `crews`
      // creation and `users`/`private/profile` already work.
      allow delete: if false;

      match /rsvps/{rsvpUserId} {
        allow read: if isSignedIn() && (rsvpUserId == request.auth.uid || isTableHost(tableId));
        allow write: if false;
        // ALL RSVP writes go through callable functions (requestSeat,
        // confirmAttendee, cancelTable/cancelRsvp — Milestone F4), never a
        // direct client write — this is where the capacity invariant above
        // actually lives, and a rule cannot enforce it safely on its own.
      }
    }

    // --- crews/{crewId} --- docs/DATABASE.md §3.4

    match /crews/{crewId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if false;
      // Crew creation (createCrew, Milestone F4) always goes through a
      // callable using the Admin SDK, which validates the creator and sets
      // the initial memberIds/members map — never a direct client-side
      // document create, unlike Tables above.
      allow update: if isSignedIn()
                    && resource.data.members[request.auth.uid].role == 'admin'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['name', 'photoUrl', 'updatedAt']);
      // Milestone F4 correction: the F1 rule allowed *any* member (not just
      // an admin) to write directly, and used a denylist
      // (`hasAny([...memberIds/members/tableHistoryCount])`) rather than an
      // allowlist — meaning any newly added field (e.g., `recurrence`,
      // already in docs/DATABASE.md's schema but ungoverned by any callable
      // until `scheduleRecurringTable` lands in Phase 1) was silently
      // client-writable by default, and any member — not just an admin —
      // could rename or re-photo the Crew, contradicting `updateCrew`'s
      // real implementation (functions/src/crews/index.ts, Milestone F4),
      // which is admin-only. Both gaps are the same category Milestone F2
      // found for `users`/`private/profile` and F4 found for `tables`: a
      // rule that checks *whose* uid is writing without also fully
      // constraining *what* gets written. Fixed the same way `users`'s
      // update rule was: (1) admin-only, matching `updateCrew`'s real
      // permission check exactly — a single map-lookup condition, unlike
      // Tables' multi-document `CANNOT_EDIT_AFTER_CONFIRMED` invariant, so
      // narrowing rather than going fully Functions-only is safe and
      // correctly scoped here; (2) `hasOnly(['name', 'photoUrl',
      // 'updatedAt'])` — an allowlist, not a denylist, so `recurrence`
      // (ungoverned until Phase 1) and any future schema field are denied
      // by default rather than needing to be remembered and added to a
      // denylist. `updatedAt` is allowed since `updateCrew` itself sets it
      // on every patch.
      allow delete: if false;
    }

    // --- idempotencyKeys/{idempotencyKey} --- docs/DATABASE.md §3.9

    match /idempotencyKeys/{idempotencyKey} {
      allow read, write: if false;
      // Purely internal to Cloud Functions (the create()-then-check-status
      // pattern described in docs/DATABASE.md §3.9) — no client path ever
      // needs to touch this collection directly.
    }

    // --- rateLimits/{bucketId} --- docs/DATABASE.md §3.9a (Milestone F4)

    match /rateLimits/{bucketId} {
      allow read, write: if false;
      // Purely internal to Cloud Functions (functions/src/shared/rateLimit.ts)
      // — no client path ever needs to touch this collection directly. Would
      // already be covered by the trailing default-deny catch-all below, but
      // called out explicitly here, same as idempotencyKeys above, since
      // this file's own principle #1 is "default-deny, then the minimum
      // explicit allow each collection needs" — an infra collection with
      // zero client access is worth naming, not just silently relying on
      // the catch-all to cover it.
    }

    // --- everything else: default-deny, fails closed not open ---
    // Ratings, Reports, Venues, splitRequests, and the duressSignals/
    // locationShares/crew-messages subcollections are out of Milestone F1's
    // scope (docs/IMPLEMENTATION_PLAN.md) and are covered only by this
    // catch-all until their own milestone adds real rules + tests for them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
