# macOS
.DS_Store

# Sandbox/local scratch (never committed; see IMPLEMENTATION_PLAN.md environment notes)
.sandbox-debris/

# Flutter/Dart (app/)
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/
app/build/
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/android/.gradle/
app/android/local.properties
app/*.iml
app/coverage/

# Riverpod/build_runner generated code (Milestone F3) - regenerated by CI's
# "Generate code (build_runner)" step (.github/workflows/ci.yml) and by
# `dart run build_runner build` locally, per every @riverpod-annotated
# file's `part 'x.g.dart'` directive. Not committed, same reasoning as
# functions/lib/ above: a generated artifact that's cheap to regenerate and
# risks silently drifting from its source if committed and forgotten about.
app/lib/**/*.g.dart
app/test/**/*.g.dart

# Alchemist golden tests (Milestone F3, Recommendation R2). Per Alchemist's
# own Recommended Setup Guide: platform ("readable") golden PNGs are
# inherently unstable across machines/OSes (font rendering differs between
# macOS/Linux/Windows), so only the Ahem-font "ci/" goldens - which are
# platform-agnostic by construction - are committed as the real regression
# reference. Platform goldens and any failure-diff images stay local, for a
# developer's own visual debugging.
app/test/**/goldens/**/*.*
app/test/**/failures/**/*.*
!app/test/**/goldens/ci/*.*

# Node / Cloud Functions (functions/)
functions/node_modules/
functions/lib/
functions/lib-test/
functions/coverage/
npm-debug.log*

# Node / Firestore rules tests (firestore/test/rules/) - Milestone F1
firestore/test/rules/node_modules/
firestore/test/rules/lib/

# Node / ops scripts (scripts/) - Milestone F1
scripts/node_modules/
scripts/lib/

# Ad hoc local debug output (never committed - see CHANGELOG.md's Milestone
# F1/F2/F3 entries for why files like this exist; delete them locally once
# you're done with them)
rules-test-output.txt
build-output*.txt
integration-test-output*.txt
pub-get-output*.txt
buildrunner-output.txt
analyze-output.txt
pub-add-output*.txt
format-output.txt
# Generalized (2026-08, F3 golden-test work): the exact-filename list above
# kept growing one command at a time (test-output.txt, golden-generate-
# output.txt, ...); a single glob covers this whole ad hoc pattern instead
# of needing another entry added per new command. The named entries above
# are kept since removing them would be a no-op churn, not a fix.
*-output.txt
*-output-*.txt

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Environment / secrets (never commit real secrets — see FIREBASE.md/CI_CD.md)
.env
.env.*
!.env.*.template
!.env.example
!.env.*.example
google-services.json
GoogleService-Info.plist
*.p12
*.jks
*.keystore
